[Unit]
Description=OpenVLC STM32 receiver bridge
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/default/openvlc-rx
ExecStart=/usr/bin/python3 /opt/openvlc-raspberry/vlc_rx_bridge.py --port ${OPENVLC_SERIAL_PORT} --baud ${OPENVLC_SERIAL_BAUD} --dev ${OPENVLC_TUN_DEVICE} --ip ${OPENVLC_TUN_CIDR} --source-route ${OPENVLC_SOURCE_ROUTE} --stats-interval ${OPENVLC_STATS_INTERVAL}
Restart=on-failure
RestartSec=1
User=root
WorkingDirectory=/opt/openvlc-raspberry

[Install]
WantedBy=multi-user.target
