[Unit]
Description=OpenVLC STM32 transmitter TUN-to-serial bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OPENVLC_PEER_IP=192.168.0.2
EnvironmentFile=-/etc/default/openvlc-tx-stm32
ExecStart=/usr/bin/python3 /opt/openvlc-raspberry/vlc_stm32_tx_bridge.py --port ${OPENVLC_SERIAL_PORT} --baud ${OPENVLC_SERIAL_BAUD} --dev ${OPENVLC_TUN_DEVICE} --ip ${OPENVLC_TUN_CIDR} --peer-ip ${OPENVLC_PEER_IP} --mtu ${OPENVLC_MTU} --stats-interval ${OPENVLC_STATS_INTERVAL}
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
