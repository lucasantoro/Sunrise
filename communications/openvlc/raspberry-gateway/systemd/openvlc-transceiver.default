# Template. install/install_transceiver_service.sh stamps the three
# per-node values below from the hostname (nodeA -> a -> 192.168.0.1).
# There is deliberately no per-node copy of this file: three lines of
# difference multiplied by every node is how the old layout stopped
# scaling at two.
OPENVLC_SERIAL_PORT=auto
OPENVLC_SERIAL_BAUD=2000000
OPENVLC_TUN_DEVICE=tun0
OPENVLC_TUN_CIDR=192.168.0.2/24
OPENVLC_PEER_IP=192.168.0.1
OPENVLC_SOURCE_ROUTE=10.0.0.0/24
OPENVLC_MTU=900
OPENVLC_STATS_INTERVAL=5
OPENVLC_TX_MAX_FPS=125
OPENVLC_CAPTURE_DIR=/opt/openvlc-raspberry/logs/captures
OPENVLC_CAPTURE_NODE=
