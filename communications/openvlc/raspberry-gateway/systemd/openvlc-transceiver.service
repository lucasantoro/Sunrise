[Unit]
Description=OpenVLC STM32 bidirectional transceiver bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OPENVLC_SOURCE_ROUTE=10.0.0.0/24
Environment=OPENVLC_TX_MAX_FPS=125
Environment=OPENVLC_CAPTURE_DIR=/opt/openvlc-raspberry/logs/captures
Environment=OPENVLC_CAPTURE_NODE=node
EnvironmentFile=-/etc/default/openvlc-transceiver
ExecStart=/usr/bin/python3 /opt/openvlc-raspberry/vlc_transceiver_bridge.py --port ${OPENVLC_SERIAL_PORT} --baud ${OPENVLC_SERIAL_BAUD} --dev ${OPENVLC_TUN_DEVICE} --ip ${OPENVLC_TUN_CIDR} --peer-ip ${OPENVLC_PEER_IP} --source-route=${OPENVLC_SOURCE_ROUTE} --mtu ${OPENVLC_MTU} --stats-interval ${OPENVLC_STATS_INTERVAL} --tx-max-fps ${OPENVLC_TX_MAX_FPS} --capture-dir ${OPENVLC_CAPTURE_DIR} --capture-node ${OPENVLC_CAPTURE_NODE}
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
