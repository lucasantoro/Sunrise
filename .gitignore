# Repository-wide ignores.

# --- AI assistant working directories -------------------------------------
# Session state, scratch notes and tool workspaces. Local aids, not part of
# the project, and nothing here should reach a public clone.
.claude/
.codex/
.codex-tmp/
.cursor/
.aider*
.continue/
.windsurf/
CLAUDE.md
AGENTS.md
GEMINI.md
.mcp.json
.github/copilot-instructions.md

# --- Build outputs ---------------------------------------------------------
# Every one of these is regenerated by cmake/make/CubeIDE. They were tracked
# once and made up most of the repository's file count.
build/
build-*/
Debug/
Release/
cmake-build-*/
CMakeFiles/
CMakeCache.txt

*.o
*.obj
*.d
*.su
*.lst
*.map
*.elf
*.hex
*.exe
*.ilk
*.pdb
*.res
*.manifest
!*/PRU/lib/*.lib

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store

# --- Bench output ----------------------------------------------------------
# Per-run logs and captures. See communications/openvlc/raspberry-gateway/logs/
*.log
!communications/openvlc/**/docs/**/*.log

# --- Local scratch and generated output ------------------------------------
# tmp/ holds probe scripts, screenshots and working copies of third-party
# projects. outputs/ holds generated presentations, videos and images. Neither
# has ever been tracked; keeping it that way avoids publishing scratch work,
# and in tmp/'s case someone else's source.
tmp/
outputs/

# --- Superseded work -------------------------------------------------------
# The BeagleBone chain and the five STM32 stages that preceded firmware-v2.
# Two thirds of the file count, none of it built or run. Kept locally and in
# the pre-publication history backup; not part of the published project.
communications/openvlc/archive/

# Bench capture corpus. The captures worth keeping travel as a documented
# tarball in communications/openvlc/firmware-v2/docs/captures/ instead.
communications/openvlc/.analysis/

# --- Large generated datasets ----------------------------------------------
# Zemax ray databases. Carclo10391_CREE_XHP35_White.ZDA is 1.4 GB of traced
# rays generated from the .zmx source model beside it, and past GitHub's 100 MB
# per-file limit. The .zmx is the design; the .ZDA is rebuilt from it.
*.ZDA
*.zda
